        "image": "https://dominicmaas.co.nz/images/profile2.jpg",
        "email": "mailto:dominic.maas@@live.com",
        "sameAs": [
            "https://github.com/DominicMaas/",
            "https://www.linkedin.com/in/dominicjmaas/",
            "https://x.com/dominicjmaas"
        ],
        "jobTitle": "Windows App Developer",
        "knowsAbout": [
            "WinUI 3",
            "Windows App SDK",
