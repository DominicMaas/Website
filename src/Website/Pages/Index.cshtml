@page
@model IndexModel
@{
    ViewData["Title"] = "Dominic Maas - .NET & WinUI Developer";
    ViewData["Description"] = "Dominic Maas is a .NET and WinUI developer building Windows desktop apps in C# and XAML, using WinUI (Windows App SDK), WPF and UWP. Based in Hamilton, New Zealand.";

}

